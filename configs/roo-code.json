{
  "mcpServers": {
    "econbiz": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/mbravidor/econbiz-mcp", "econbiz-mcp"],
      "env": {
        "ECONBIZ_APP_NAME": "econbizmcp"
      },
      "alwaysAllow": ["search", "get_record", "get_availability", "find_similar", "suggest", "list_fields"],
      "disabled": false
    }
  }
}
