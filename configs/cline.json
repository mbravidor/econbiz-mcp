{
  "mcpServers": {
    "econbiz": {
      "command": "uvx",
      "args": [
        "--from",
        "git+ssh://git@github.com/mbravidor/econbiz-mcp",
        "econbiz-mcp"
      ],
      "env": {
        "ECONBIZ_APP_NAME": "econbizmcp"
      },
      "disabled": false,
      "autoApprove": [
        "search",
        "get_record",
        "get_availability",
        "find_similar",
        "suggest",
        "list_fields"
      ]
    }
  }
}
